---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import ContentImage from "@/components/ContentImage.astro";
import {
    getCollectionPath,
    getFlashCardsPath,
    getLearnPath,
} from "@/lib/utils";
import { assertImageReferencesValid } from "@/lib/image-validation";
import { normalizeLevel, type Level } from "@/lib/progress";
import { levelSurfaces } from "@/theme/warm-paper";

const collections = await getCollection("flashcard-collections");

// Build-time validation: ensure all imageUrl references exist in public/
assertImageReferencesValid(
    collections.map((c) => ({
        id: c.data.collectionId,
        collection: "flashcard-collections",
        imageUrl: c.data.imageUrl,
    })),
);

const LEVEL_ORDER: Level[] = [
    "beginner",
    "elementary",
    "intermediate",
    "advanced",
];

/** Pale surface + border tint per level (matches /reading) */
const LEVEL_STYLE: Record<
    Level,
    { card: string; label: string; emoji: string }
> = {
    beginner: {
        card: levelSurfaces.beginner.card,
        label: "Beginner",
        emoji: "🌱",
    },
    elementary: {
        card: levelSurfaces.elementary.card,
        label: "Elementary",
        emoji: "📘",
    },
    intermediate: {
        card: levelSurfaces.intermediate.card,
        label: "Intermediate",
        emoji: "🧭",
    },
    advanced: {
        card: levelSurfaces.advanced.card,
        label: "Advanced",
        emoji: "✨",
    },
};

function levelForCollection(collection: (typeof collections)[0]): Level {
    const n = normalizeLevel(collection.data.difficulty ?? null);
    if (n) return n;
    // id fallbacks
    const id = collection.data.collectionId.toLowerCase();
    if (id.includes("beginner")) return "beginner";
    if (id.includes("elementary")) return "elementary";
    if (id.includes("intermediate")) return "intermediate";
    if (id.includes("advanced")) return "advanced";
    return "beginner";
}

function levelSortKey(level: Level): number {
    const i = LEVEL_ORDER.indexOf(level);
    return i >= 0 ? i : 99;
}

const sorted = [...collections].sort((a, b) => {
    const la = levelForCollection(a);
    const lb = levelForCollection(b);
    const byLevel = levelSortKey(la) - levelSortKey(lb);
    if (byLevel !== 0) return byLevel;
    return a.data.name.localeCompare(b.data.name);
});

const byLevel = new Map<Level, typeof collections>();
for (const level of LEVEL_ORDER) byLevel.set(level, []);
for (const c of sorted) {
    byLevel.get(levelForCollection(c))!.push(c);
}
---

<PageLayout
  title="Flashcards | Lingo Lotus"
  description="Build your vocabulary systematically with spaced repetition and interactive flashcards."
  ogType="website"
  canonicalPath={getFlashCardsPath()}
  breadcrumbs={[
    { label: "Learn", href: getLearnPath() },
    { label: "Flash Cards" },
  ]}
>
  {collections.length === 0 ? (
    <div class="rounded-lg border border-stone-200 bg-stone-50 p-8 text-center">
      <p class="text-lg text-stone-600">
        No flashcard collections available yet.
      </p>
    </div>
  ) : (
    <div class="space-y-10">
      <section class="rounded-3xl border border-stone-200 bg-stone-50 px-6 py-10 sm:px-10 sm:py-14">
        <p class="mb-2 text-3xl" aria-hidden="true">🃏</p>
        <h1 class="mb-4 text-3xl font-bold text-stone-900 sm:text-4xl">
          Practice Flashcards
        </h1>
        <p class="mb-2 text-lg text-stone-700">
          Collections in curriculum order — from first vocabulary through advanced phrases.
        </p>
        <p class="text-base text-stone-600">
          Follow the path on Learn, or jump into any collection. Color shows level at a glance.
        </p>
      </section>

      {LEVEL_ORDER.map((level) => {
        const levelCollections = byLevel.get(level) ?? [];
        if (levelCollections.length === 0) return null;
        const style = LEVEL_STYLE[level];
        return (
          <section>
            <h2 class="mb-4 flex items-center gap-2 text-xl font-bold text-stone-900 sm:text-2xl">
              <span aria-hidden="true">{style.emoji}</span>
              {style.label}
            </h2>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {levelCollections.map((collection) => (
                <a
                  href={getCollectionPath(collection.data.collectionId)}
                  class:list={[
                    "group flex flex-col overflow-hidden rounded-2xl border shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md",
                    style.card,
                  ]}
                >
                  {collection.data.imageUrl ? (
                    <div class="aspect-video w-full overflow-hidden bg-paper/50">
                      <ContentImage
                        src={collection.data.imageUrl}
                        alt={collection.data.name}
                        width={400}
                        height={225}
                        class="h-full w-full object-cover transition-transform group-hover:scale-105"
                        loading="lazy"
                      />
                    </div>
                  ) : (
                    <div class="flex aspect-video w-full items-center justify-center bg-paper/60 text-5xl" aria-hidden="true">
                      {style.emoji}
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-4">
                    <h3 class="text-lg font-semibold text-stone-900 group-hover:text-orange-900">
                      <span aria-hidden="true" class="mr-1.5">{style.emoji}</span>
                      {collection.data.name}
                    </h3>
                    <p class="mt-1 flex-1 text-sm text-stone-600">
                      {collection.data.description}
                    </p>
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      <span class="inline-flex items-center rounded-full bg-paper/80 px-2 py-0.5 text-xs font-medium text-stone-700 ring-1 ring-stone-200/80">
                        {collection.data.sourceLanguage} →{" "}
                        {collection.data.targetLanguage}
                      </span>
                      {collection.data.difficulty && (
                        <span class="inline-flex items-center rounded-full bg-paper/80 px-2 py-0.5 text-xs font-medium capitalize text-stone-700 ring-1 ring-stone-200/80">
                          {collection.data.difficulty}
                        </span>
                      )}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  )}
</PageLayout>
