---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import StudyMode from "@/components/islands/StudyMode.tsx";
import { buildLadderCatalog } from "@/lib/ladder";
import { loadCurriculumUnits } from "@/lib/curriculum";
import { loadGrammarMarkdown } from "@/lib/grammar";
import { getStudyPath, getDeckPath } from "@/lib/utils";
import type { Level } from "@/lib/progress";

export async function getStaticPaths() {
  const decks = await getCollection("flashcard-decks");
  const collections = await getCollection("flashcard-collections");
  const books = await getCollection("books");
  const stories = await getCollection("stories");
  const units = loadCurriculumUnits();

  const catalog = buildLadderCatalog({
    collections: collections.map((c) => ({
      collectionId: c.data.collectionId,
      difficulty: c.data.difficulty,
    })),
    decks: decks.map((d) => ({
      deckId: d.data.deckId,
      collectionId: d.data.collectionId,
      name: d.data.name,
      description: d.data.description,
      difficulty: d.data.difficulty,
    })),
    books: books.map((b) => ({
      bookId: b.data.bookId,
      difficulty: b.data.difficulty,
    })),
    stories: stories.map((s) => ({
      storyId: s.data.storyId,
      bookId: s.data.bookId,
      title: s.data.title,
      sentences: s.data.sentences,
    })),
    units,
  });

  return decks.map((deck) => {
    const meta = catalog.deckIndex[deck.data.deckId];
    let unitId: string | null = meta?.unitId ?? null;
    // All units that use this deck (for ?unit= resolution)
    const unitPairMap: Record<
      string,
      {
        unitId: string;
        unitTitle?: string;
        level?: Level;
        stepIndex?: number;
        story?: {
          storyId: string;
          bookId: string;
          title: string;
        } | null;
      }
    > = {};
    for (const [uid, info] of Object.entries(catalog.unitIndex)) {
      if (info.deck?.deckId === deck.data.deckId) {
        unitPairMap[uid] = {
          unitId: uid,
          unitTitle: info.unitTitle,
          level: info.level ?? undefined,
          stepIndex: info.stepIndex,
          story: info.story
            ? {
                storyId: info.story.storyId,
                bookId: info.story.bookId,
                title: info.story.title,
              }
            : null,
        };
        if (!unitId) unitId = uid;
      }
    }
    return {
      params: {
        collectionId: deck.data.collectionId,
        deckId: deck.data.deckId,
      },
      props: {
        deck: deck.data,
        pairedStory: meta?.pairedStory
          ? {
              storyId: meta.pairedStory.storyId,
              bookId: meta.pairedStory.bookId,
              title: meta.pairedStory.title,
            }
          : null,
        level: meta?.level,
        stepIndex: meta?.stepIndex,
        unitId,
        unitPairMap,
      },
    };
  });
}

const { deck, pairedStory, level, stepIndex, unitId, unitPairMap } =
  Astro.props;
const canonicalPath = getStudyPath(deck.collectionId, deck.deckId);
const deckPath = getDeckPath(deck.collectionId, deck.deckId);

const cards = deck.cards.map((card) => ({
  frontContent: card.frontContent,
  backContent: card.backContent,
  phonetic: card.phonetic,
  partOfSpeech: card.partOfSpeech,
  context: card.context,
  tags: card.tags,
  examples: card.examples,
  sourceLanguage: card.sourceLanguage,
  targetLanguage: card.targetLanguage,
}));

const grammarMarkdown = loadGrammarMarkdown(deck.sourceLanguage);
---

<PageLayout
  title={`Study: ${deck.name}`}
  description={`Practice flashcards from ${deck.name} with interactive study mode.`}
  ogType="website"
  canonicalPath={canonicalPath}
>
  <StudyMode
    client:load
    cards={cards}
    deckName={deck.name}
    collectionId={deck.collectionId}
    deckId={deck.deckId}
    pairedStory={pairedStory}
    level={level}
    stepIndex={stepIndex}
    unitId={unitId}
    unitPairMap={unitPairMap}
    grammarMarkdown={grammarMarkdown}
    deckDetailsHref={deckPath}
  />
</PageLayout>
