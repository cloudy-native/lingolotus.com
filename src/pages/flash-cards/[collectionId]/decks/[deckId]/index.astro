---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import {
  getFlashCardsPath,
  getCollectionPath,
  getDeckPath,
  getStudyPath,
  validateDeckReferences,
} from "@/lib/utils";

export async function getStaticPaths() {
  const collections = await getCollection("flashcard-collections");
  const decks = await getCollection("flashcard-decks");

  // Referential integrity validation — fail build if any deck references a missing collection
  const validation = validateDeckReferences(
    decks.map((d) => d.data),
    collections.map((c) => c.data),
  );

  if (!validation.valid) {
    const messages = validation.errors.map((e) => e.message).join("\n");
    throw new Error(
      `Referential integrity validation failed:\n${messages}`,
    );
  }

  const collectionMap = new Map(
    collections.map((c) => [c.data.collectionId, c.data]),
  );

  return decks.map((deck) => ({
    params: {
      collectionId: deck.data.collectionId,
      deckId: deck.data.deckId,
    },
    props: {
      deck: deck.data,
      collection: collectionMap.get(deck.data.collectionId)!,
    },
  }));
}

const { deck, collection } = Astro.props;

// Get language data for native names
const languages = await getCollection("languages");
const langMap = new Map(languages.map((l) => [l.data.languageCode, l.data]));

// Fallback language info for codes not in the collection
const defaultLangs: Record<string, { language: string; english: string; flag: string }> = {
  en: { language: "English", english: "English", flag: "🇬🇧" },
  th: { language: "ไทย", english: "Thai", flag: "🇹🇭" },
  ja: { language: "日本語", english: "Japanese", flag: "🇯🇵" },
  zh: { language: "中文", english: "Chinese", flag: "🇨🇳" },
  ko: { language: "한국어", english: "Korean", flag: "🇰🇷" },
};

function getLang(code: string) {
  const fromCollection = langMap.get(code);
  if (fromCollection) return fromCollection;
  return defaultLangs[code] || { language: code.toUpperCase(), english: code.toUpperCase(), flag: "🌐" };
}

const sourceLang = getLang(deck.sourceLanguage);
const targetLang = getLang(deck.targetLanguage);

const canonicalPath = getDeckPath(deck.collectionId, deck.deckId);
const studyPath = getStudyPath(deck.collectionId, deck.deckId);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: deck.name,
  description: deck.description,
  url: `https://lingolotus.com${canonicalPath}`,
};

// Get example sentences from cards (use context or example phrases)
const learnToSay = deck.cards
  .filter((card) => card.examples && card.examples.length > 0)
  .flatMap((card) => card.examples!.map((ex) => ex.translation))
  .slice(0, 12);
---

<PageLayout
  title={`${deck.name} | Lingo Lotus`}
  description={deck.description}
  ogType="article"
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Collections", href: getFlashCardsPath() },
    { label: collection.name, href: getCollectionPath(collection.collectionId) },
    { label: deck.name },
  ]}
>
  <div class="space-y-10">
    <!-- Deck Header -->
    <header>
      <h1 class="mb-2 text-3xl font-bold text-gray-900 ">
        {deck.name}
      </h1>
      <p class="mb-4 text-lg text-gray-600 ">
        {deck.description}
      </p>

      <!-- Badges -->
      <div class="mb-3 flex flex-wrap gap-2">
        <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800  ">
          {deck.sourceLanguage} → {deck.targetLanguage}
        </span>
        {deck.difficulty && (
          <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800  ">
            {deck.difficulty}
          </span>
        )}
        {deck.category && (
          <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700  ">
            {deck.category}
          </span>
        )}
      </div>

      <!-- Meta info -->
      <p class="mb-5 flex items-center gap-1 text-sm text-gray-500 ">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        Updated: {new Date(deck.updatedAt).toLocaleDateString()}, flashcards: {deck.cards.length}
      </p>

      <!-- Study direction -->
      <div class="mb-4">
        <p class="mb-2 text-sm font-medium text-gray-700 ">Choose your study direction:</p>
        <p class="mb-1 text-sm text-gray-600 ">
          <strong>Study in {sourceLang.language} {sourceLang.flag}</strong>: See {sourceLang.language} text, guess the {targetLang.english} translation
        </p>
        <p class="mb-4 text-sm text-gray-600 ">
          <strong>Study in {targetLang.english} {targetLang.flag}</strong>: See {targetLang.english} text, guess the {sourceLang.language} translation
        </p>
      </div>

      <!-- Study buttons -->
      <div class="flex flex-wrap gap-3">
        <a
          href={studyPath}
          class="inline-flex items-center gap-2 rounded-lg bg-slate-800 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2"
        >
          Study in {sourceLang.language} {sourceLang.flag}
        </a>
        <a
          href={studyPath}
          class="inline-flex items-center gap-2 rounded-lg bg-teal-700 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-teal-800 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2"
        >
          Study in {targetLang.english} {targetLang.flag}
        </a>
      </div>
    </header>

    <!-- Learn to Say -->
    {learnToSay.length > 0 && (
      <section>
        <h2 class="mb-4 text-2xl font-bold text-gray-900 ">
          Learn to Say
        </h2>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          {learnToSay.map((phrase) => (
            <span class="inline-flex items-center gap-1.5 text-sm text-gray-700 ">
              <span>{sourceLang.flag}</span>
              {phrase}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- Cards preview (if no examples, show card front/back list) -->
    {learnToSay.length === 0 && (
      <section>
        <h2 class="mb-4 text-2xl font-bold text-gray-900 ">
          Learn to Say
        </h2>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          {deck.cards.slice(0, 12).map((card) => (
            <span class="inline-flex items-center gap-1.5 text-sm text-gray-700 ">
              <span>{sourceLang.flag}</span>
              {card.backContent.text}
            </span>
          ))}
        </div>
      </section>
    )}
  </div>
</PageLayout>
