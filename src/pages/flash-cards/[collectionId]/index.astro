---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import ContentImage from "@/components/ContentImage.astro";
import { getFlashCardsPath, getDeckPath, getStudyPath, getCollectionPath } from "@/lib/utils";

export async function getStaticPaths() {
  const collections = await getCollection("flashcard-collections");
  return collections.map((collection) => ({
    params: { collectionId: collection.data.collectionId },
    props: { collection: collection.data },
  }));
}

const { collection } = Astro.props;
const allDecks = await getCollection("flashcard-decks");
const decks = allDecks.filter(
  (deck) => deck.data.collectionId === collection.collectionId,
);

// Other collections for "You May Also Like"
const allCollections = await getCollection("flashcard-collections");
const otherCollections = allCollections.filter(
  (c) => c.data.collectionId !== collection.collectionId,
);

const canonicalPath = getCollectionPath(collection.collectionId);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: collection.name,
  description: collection.description,
  url: `https://lingolotus.com${canonicalPath}`,
};
---

<PageLayout
  title={`${collection.name} - Lingo Lotus`}
  description={collection.description}
  ogType="article"
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Collections", href: getFlashCardsPath() },
    { label: collection.name },
  ]}
>
  <div class="space-y-12">
    <!-- Collection Header -->
    <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-6">
      {collection.imageUrl && (
        <ContentImage
          src={collection.imageUrl}
          alt={collection.name}
          width={160}
          height={160}
          class="h-32 w-32 flex-shrink-0 rounded-lg object-cover shadow-md sm:h-40 sm:w-40"
          loading="eager"
        />
      )}
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-bold text-gray-900  sm:text-3xl">
            {collection.name}
          </h1>
        </div>
        <p class="mt-2 text-lg text-gray-600 ">
          {collection.description}
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="inline-flex items-center rounded-full bg-blue-100 px-3 py-1 text-sm font-medium text-blue-800  ">
            {collection.sourceLanguage} → {collection.targetLanguage}
          </span>
          {collection.difficulty && (
            <span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-800  ">
              {collection.difficulty}
            </span>
          )}
          {collection.category && (
            <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700  ">
              {collection.category}
            </span>
          )}
        </div>
      </div>
    </header>

    <!-- Decks in this Collection -->
    <section>
      <h2 class="mb-6 text-2xl font-bold text-gray-900 ">
        Decks in this Collection
      </h2>

      {decks.length === 0 ? (
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-8 text-center  ">
          <p class="text-lg text-gray-600 ">
            No decks available in this collection yet.
          </p>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {decks.map((deck) => (
            <div class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition-all hover:-translate-y-0.5 hover:shadow-lg hover:border-slate-300">
              <a href={getDeckPath(collection.collectionId, deck.data.deckId)} class="flex-1 p-5">
                <h3 class="mb-2 text-lg font-semibold text-gray-900 ">
                  {deck.data.name}
                </h3>
                <p class="mb-3 line-clamp-2 text-sm text-gray-600 ">
                  {deck.data.description}
                </p>
                <div class="mb-3 flex items-center justify-between text-xs text-gray-500 ">
                  <span class="flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    {new Date(deck.data.updatedAt).toLocaleDateString()}
                  </span>
                  <span>{deck.data.cards.length} cards</span>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {deck.data.category && (
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700  ">
                      {deck.data.category}
                    </span>
                  )}
                  {deck.data.difficulty && (
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800  ">
                      {deck.data.difficulty}
                    </span>
                  )}
                </div>
              </a>
              <a
                href={getStudyPath(collection.collectionId, deck.data.deckId)}
                class="flex items-center justify-center gap-2 border-t border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-slate-900"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
                </svg>
                Study Deck
              </a>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- You May Also Like -->
    {otherCollections.length > 0 && (
      <section>
        <h2 class="mb-6 text-2xl font-bold text-gray-900 ">
          You May Also Like
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {otherCollections.map((other) => (
            <a
              href={getCollectionPath(other.data.collectionId)}
              class="group overflow-hidden rounded-2xl border border-slate-200 bg-white transition-all hover:-translate-y-0.5 hover:shadow-lg hover:border-slate-300"
            >
              {other.data.imageUrl && (
                <ContentImage
                  src={other.data.imageUrl}
                  alt={other.data.name}
                  width={400}
                  height={192}
                  class="h-40 w-full object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-4">
                <h3 class="mb-1 font-semibold text-gray-900 group-hover:text-teal-700">
                  {other.data.name}
                </h3>
                <p class="line-clamp-2 text-sm text-gray-600 ">
                  {other.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</PageLayout>
