---
import PageLayout from "../layouts/PageLayout.astro";
import {
  getFlashCardsPath,
  getReadingPath,
  getLearnPath,
} from "../lib/utils";
---

<PageLayout
  title="Browse | Lingo Lotus"
  description="Browse all Thai flashcard decks and graded reading stories."
  ogType="website"
  canonicalPath="/browse"
  breadcrumbs={[
    { label: "Learn", href: getLearnPath() },
    { label: "Browse" },
  ]}
>
  <div class="mx-auto max-w-2xl space-y-8">
    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-stone-900">
        <span aria-hidden="true">🗂️</span> Browse
      </h1>
      <p class="text-stone-600">
        All flashcards and stories — jump in anywhere. Your Learn path keeps
        suggesting what’s next.
      </p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      <a
        href={getFlashCardsPath()}
        class="group rounded-2xl border border-stone-200 bg-paper p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-md"
      >
        <span
          class="flex h-14 w-14 items-center justify-center rounded-2xl bg-orange-50 text-3xl ring-1 ring-orange-100"
          aria-hidden="true"
        >
          🃏
        </span>
        <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-orange-800">
          Flashcards
        </p>
        <h2 class="mt-1 text-xl font-bold text-stone-900 group-hover:text-orange-900">
          Vocabulary decks
        </h2>
        <p class="mt-2 text-sm text-stone-600">
          Practice words and phrases by theme and level, with phonetics and
          examples.
        </p>
        <span class="mt-4 inline-flex text-sm font-semibold text-orange-800">
          Open flashcards →
        </span>
      </a>

      <a
        href={getReadingPath()}
        class="group rounded-2xl border border-stone-200 bg-paper p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-md"
      >
        <span
          class="flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-50 text-3xl ring-1 ring-amber-100"
          aria-hidden="true"
        >
          📖
        </span>
        <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-orange-800">
          Reading
        </p>
        <h2 class="mt-1 text-xl font-bold text-stone-900 group-hover:text-orange-900">
          Graded stories
        </h2>
        <p class="mt-2 text-sm text-stone-600">
          Short stories with translations, phonetics, and word-by-word help.
        </p>
        <span class="mt-4 inline-flex text-sm font-semibold text-orange-800">
          Open reading →
        </span>
      </a>
    </div>

    <a
      href={getLearnPath()}
      class="flex items-center gap-3 rounded-2xl border border-orange-200 bg-orange-50/80 p-4 transition-colors hover:border-orange-300 hover:bg-orange-50"
    >
      <span
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-paper text-2xl shadow-sm"
        aria-hidden="true"
      >
        🗺️
      </span>
      <div>
        <p class="font-semibold text-orange-950">Full learning path</p>
        <p class="text-sm text-orange-900/80">
          All units on a clickable map — cards + stories paired by theme.
        </p>
      </div>
      <span class="ml-auto text-orange-800" aria-hidden="true">→</span>
    </a>

    <p class="text-center text-sm text-stone-500">
      <a href={getLearnPath()} class="font-medium text-orange-800 hover:text-orange-950">
        ← Back to Learn
      </a>
    </p>
  </div>
</PageLayout>
