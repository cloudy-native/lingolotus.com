---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import LearnHome, { type StoryTeaser } from "../components/islands/LearnHome";
import { buildLadderCatalog } from "../lib/ladder";
import { loadCurriculumUnits } from "../lib/curriculum";
import { getStoryPath, withUnitQuery } from "../lib/utils";
import type { Level } from "../lib/progress";

const collections = await getCollection("flashcard-collections");
const decks = await getCollection("flashcard-decks");
const books = await getCollection("books");
const stories = await getCollection("stories");
const units = loadCurriculumUnits();

const catalog = buildLadderCatalog({
  collections: collections.map((c) => ({
    collectionId: c.data.collectionId,
    difficulty: c.data.difficulty,
  })),
  decks: decks.map((d) => ({
    deckId: d.data.deckId,
    collectionId: d.data.collectionId,
    name: d.data.name,
    description: d.data.description,
    difficulty: d.data.difficulty,
  })),
  books: books.map((b) => ({
    bookId: b.data.bookId,
    difficulty: b.data.difficulty,
  })),
  stories: stories.map((s) => ({
    storyId: s.data.storyId,
    bookId: s.data.bookId,
    title: s.data.title,
    sentences: s.data.sentences,
  })),
  units,
});

const bookById = new Map(books.map((b) => [b.data.bookId, b.data]));
const storyById = new Map(stories.map((s) => [s.data.storyId, s.data]));
const unitById = new Map(units.map((u) => [u.unitId, u]));

/** Curated teasers — variety of levels + book covers (for home gallery) */
const SHOWCASE_UNIT_IDS = [
  "beginner-greetings",
  "beginner-food",
  "beginner-places",
  "elementary-new-friend",
  "intermediate-market",
  "intermediate-travel",
  "advanced-family-reunion",
  "advanced-music-festival",
] as const;

const storyTeasers: StoryTeaser[] = SHOWCASE_UNIT_IDS.flatMap((unitId) => {
  const unit = unitById.get(unitId);
  if (!unit?.storyId || !unit.bookId) return [];
  const story = storyById.get(unit.storyId);
  const book = bookById.get(unit.bookId);
  if (!story || !book?.imageUrl) return [];
  const level = (unit.level || "beginner") as Level;
  return [
    {
      unitId: unit.unitId,
      storyId: story.storyId,
      bookId: book.bookId,
      level,
      titleEn: story.title.target,
      titleTh: story.title.source,
      blurb: story.summary?.target ?? unit.title?.en ?? "",
      imageUrl: book.imageUrl,
      href: withUnitQuery(
        getStoryPath(book.bookId, story.storyId),
        unit.unitId,
      ),
      unitHref: `/unit/${unit.unitId}`,
    },
  ];
});
---

<PageLayout
  title="Learn Thai | Lingo Lotus"
  description="Learn Thai with a clear path: short flashcard steps and simple stories with phonetics. Free forever, no account."
  ogType="website"
  canonicalPath="/"
>
  <LearnHome client:load catalog={catalog} storyTeasers={storyTeasers} />
</PageLayout>
