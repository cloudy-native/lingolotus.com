---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import ContentImage from "../components/ContentImage.astro";
import {
  getCollectionPath,
  getFlashCardsPath,
  getBookPath,
  getReadingPath,
} from "../lib/utils";
import { assertImageReferencesValid } from "../lib/image-validation";

const allCollections = await getCollection("flashcard-collections");
const allBooks = await getCollection("books");

// Build-time validation: ensure all imageUrl references exist in public/
assertImageReferencesValid(
  [
    ...allCollections.map((c) => ({
      id: c.data.collectionId,
      collection: "flashcard-collections",
      imageUrl: c.data.imageUrl,
    })),
    ...allBooks.map((b) => ({
      id: b.data.bookId,
      collection: "books",
      imageUrl: b.data.imageUrl,
    })),
  ],
);

// Featured items
const featuredCollections = allCollections.filter((c) => c.data.featured === true);
const featuredBooks = allBooks.filter((b) => b.data.featured === true);

// Counts by language
const thaiCollectionCount = allCollections.filter(
  (c) => c.data.sourceLanguage === "th",
).length;
const thaiBookCount = allBooks.filter(
  (b) => b.data.sourceLanguage === "th",
).length;

// Use a representative image for each section header
// Flashcards: use the first collection's image or a fallback
const flashcardsHeaderImage = allCollections[0]?.data.imageUrl || "/images/DO01000111.jpeg";
// Reading: use the first book's image or a fallback
const readingHeaderImage = allBooks[0]?.data.imageUrl || "/images/IMG_5307.jpeg";
---

<PageLayout
  title="Lingo Lotus - Learn Languages Naturally"
  description="Master vocabulary with spaced repetition flashcards and build reading comprehension with stories that include phonetics and word-by-word breakdowns."
  ogType="website"
  canonicalPath="/"
>
  <!-- Hero Section -->
  <section class="mb-10">
    <div class="flex flex-col items-center gap-6 md:flex-row md:gap-10">
      <div class="flex-1 text-center md:text-left">
        <h1 class="mb-3 text-3xl font-bold text-gray-900  sm:text-4xl">
          🪷 Lingo Lotus
        </h1>
        <p class="mb-2 text-xl font-semibold text-gray-800 ">
          Language learning made easy
        </p>
        <p class="mb-4 text-base text-gray-600  sm:text-lg">
          Master vocabulary with spaced repetition flashcards and build reading comprehension with stories that include phonetics and word-by-word breakdowns. Everything you need to learn naturally and effectively.
        </p>
        <p class="text-base font-bold text-primary-700  sm:text-lg">
          ✨ Free forever. No subscriptions, no paywalls.
        </p>
      </div>
      <div class="w-full max-w-full flex-shrink-0 sm:max-w-sm md:max-w-[400px]">
        <img
          src="/images/bangkok-rainbow.jpeg"
          alt="Colorful Bangkok cityscape representing language learning journey"
          width="400"
          height="300"
          class="h-[200px] w-full rounded-lg object-cover shadow-xl sm:h-[250px] md:h-[300px]"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Two-column layout: Flashcards | Reading -->
  <div class="grid gap-8 lg:grid-cols-2">
    <!-- Flashcards Section -->
    <section>
      <div class="mb-6 flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-2xl font-bold text-gray-900 ">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25" />
          </svg>
          Flashcards
        </h2>
        <a
          href={getFlashCardsPath()}
          class="inline-flex items-center gap-1 rounded-md bg-primary-600 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-primary-700  :bg-primary-600"
        >
          Browse All
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      </div>

      <!-- Section card with image and description -->
      <a href={getFlashCardsPath()} class="mb-6 block overflow-hidden rounded-2xl border border-slate-200 bg-white transition-all hover:-translate-y-0.5 hover:shadow-lg hover:border-slate-300">
        <ContentImage
          src={flashcardsHeaderImage}
          alt="Flashcards section"
          width={600}
          height={250}
          class="h-48 w-full object-cover"
          loading="eager"
        />
        <div class="p-4">
          <p class="text-sm text-gray-600 ">
            Learn vocabulary with spaced repetition. Each card includes translations, phonetics, and example sentences. Perfect for building your word bank.
          </p>
          <div class="mt-3">
            <span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-sm font-semibold text-green-800  ">
              TH ({thaiCollectionCount})
            </span>
          </div>
        </div>
      </a>

      <!-- Featured flashcard collections -->
      {featuredCollections.length > 0 && (
        <div>
          <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500 ">
            Featured
          </h3>
          <div class="space-y-3">
            {featuredCollections.map((collection) => (
              <a
                href={getCollectionPath(collection.data.collectionId)}
                class="group flex items-center gap-3 rounded-lg border border-gray-200 bg-white p-3 transition-all hover:border-primary-400 hover:shadow-sm   :border-primary-500"
              >
                {collection.data.imageUrl && (
                  <ContentImage
                    src={collection.data.imageUrl}
                    alt={collection.data.name}
                    width={80}
                    height={80}
                    class="h-16 w-16 flex-shrink-0 rounded-md object-cover"
                    loading="lazy"
                  />
                )}
                <div class="min-w-0 flex-1">
                  <p class="font-medium text-gray-900 group-hover:text-primary-600  :text-primary-400">
                    {collection.data.name}
                  </p>
                  <p class="mt-0.5 text-sm text-gray-500  line-clamp-1">
                    {collection.data.description}
                  </p>
                  <div class="mt-1.5 flex flex-wrap gap-1.5">
                    <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800  ">
                      {collection.data.sourceLanguage} → {collection.data.targetLanguage}
                    </span>
                    {collection.data.difficulty && (
                      <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800  ">
                        {collection.data.difficulty}
                      </span>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- Reading Section -->
    <section>
      <div class="mb-6 flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-2xl font-bold text-gray-900 ">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
          Reading
        </h2>
        <a
          href={getReadingPath()}
          class="inline-flex items-center gap-1 rounded-md bg-primary-600 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-primary-700  :bg-primary-600"
        >
          Browse All
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      </div>

      <!-- Section card with image and description -->
      <a href={getReadingPath()} class="mb-6 block overflow-hidden rounded-2xl border border-slate-200 bg-white transition-all hover:-translate-y-0.5 hover:shadow-lg hover:border-slate-300">
        <ContentImage
          src={readingHeaderImage}
          alt="Reading section"
          width={600}
          height={250}
          class="h-48 w-full object-cover"
          loading="eager"
        />
        <div class="p-4">
          <p class="text-sm text-gray-600 ">
            Practice reading with stories that include phonetics and word-by-word breakdowns. Build comprehension and learn grammar in context.
          </p>
          <div class="mt-3">
            <span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-sm font-semibold text-green-800  ">
              TH ({thaiBookCount})
            </span>
          </div>
        </div>
      </a>

      <!-- Featured books -->
      {featuredBooks.length > 0 && (
        <div>
          <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500 ">
            Featured
          </h3>
          <div class="space-y-3">
            {featuredBooks.map((book) => (
              <a
                href={getBookPath(book.data.bookId)}
                class="group flex items-center gap-3 rounded-lg border border-gray-200 bg-white p-3 transition-all hover:border-primary-400 hover:shadow-sm   :border-primary-500"
              >
                {book.data.imageUrl && (
                  <ContentImage
                    src={book.data.imageUrl}
                    alt={book.data.name}
                    width={80}
                    height={80}
                    class="h-16 w-16 flex-shrink-0 rounded-md object-cover"
                    loading="lazy"
                  />
                )}
                <div class="min-w-0 flex-1">
                  <p class="font-medium text-gray-900 group-hover:text-primary-600  :text-primary-400">
                    {book.data.name}
                  </p>
                  <p class="mt-0.5 text-sm text-gray-500  line-clamp-1">
                    {book.data.description}
                  </p>
                  <div class="mt-1.5 flex flex-wrap gap-1.5">
                    <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800  ">
                      {book.data.sourceLanguage}
                    </span>
                    {book.data.difficulty && (
                      <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800  ">
                        {book.data.difficulty}
                      </span>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>
  </div>
</PageLayout>
