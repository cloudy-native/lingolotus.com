---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import LearnHome from "../components/islands/LearnHome";
import { buildLadderCatalog } from "../lib/ladder";
import { loadCurriculumUnits } from "../lib/curriculum";
import { getUnitPath } from "../lib/utils";
import {
    FIRST_RUN_LINE,
    type FirstRunPreview,
} from "../components/islands/FirstRunHome";

const collections = await getCollection("flashcard-collections");
const decks = await getCollection("flashcard-decks");
const books = await getCollection("books");
const stories = await getCollection("stories");
const units = loadCurriculumUnits();

const catalog = buildLadderCatalog({
    collections: collections.map((c) => ({
        collectionId: c.data.collectionId,
        difficulty: c.data.difficulty,
    })),
    decks: decks.map((d) => ({
        deckId: d.data.deckId,
        collectionId: d.data.collectionId,
        name: d.data.name,
        description: d.data.description,
        difficulty: d.data.difficulty,
    })),
    books: books.map((b) => ({
        bookId: b.data.bookId,
        difficulty: b.data.difficulty,
    })),
    stories: stories.map((s) => ({
        storyId: s.data.storyId,
        bookId: s.data.bookId,
        title: s.data.title,
        sentences: s.data.sentences,
    })),
    units,
});

const COVER_UNITS: Array<{ unitId: string; imageUrl: string }> = [
    { unitId: "beginner-greetings", imageUrl: "/images/IMG_0649.jpeg" },
    { unitId: "beginner-family", imageUrl: "/images/IMG_5492.jpeg" },
    { unitId: "beginner-food", imageUrl: "/images/IMG_5501.jpeg" },
];

const covers = COVER_UNITS.flatMap((cover) => {
    const unit = units.find((u) => u.unitId === cover.unitId);
    if (!unit) return [];
    const story = unit.storyId
        ? stories.find((s) => s.data.storyId === unit.storyId)
        : undefined;
    const opener = story?.data.sentences[0];
    return [
        {
            unitId: unit.unitId,
            titleEn: story?.data.title.target || unit.title.en,
            titleTh: unit.title.th || story?.data.title.source || unit.title.en,
            hookThai: opener?.source ?? "",
            hookEn: opener?.target ?? "",
            imageUrl: cover.imageUrl,
            href: getUnitPath(unit.unitId),
        },
    ];
});

const firstRun: FirstRunPreview = {
    lines: [FIRST_RUN_LINE],
    covers,
};
---

<PageLayout
  title="Learn Thai | Lingo Lotus"
  description="Hear a line of Thai, then learn it — short flashcard steps and simple stories with phonetics. Free forever, no account."
  ogType="website"
  canonicalPath="/"
>
  <LearnHome client:load catalog={catalog} firstRun={firstRun} />
</PageLayout>
