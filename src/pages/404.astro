---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  ogType="website"
  canonicalPath="/404"
>
  <section class="py-16 text-center">
    <div class="mx-auto max-w-lg">
      <p class="mb-4 text-6xl" aria-hidden="true">🪷</p>
      <h1 class="mb-4 text-3xl font-bold text-stone-900  sm:text-4xl">
        Page Not Found
      </h1>
      <p class="mb-8 text-lg text-stone-600 ">
        Sorry, we couldn't find what you were looking for. The page may have been moved or no longer exists.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-md bg-stone-800 px-5 py-2.5 text-base font-medium text-white transition-colors hover:bg-stone-900"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        Return Home
      </a>
    </div>
  </section>
</PageLayout>
