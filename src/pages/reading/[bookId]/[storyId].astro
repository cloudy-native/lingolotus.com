---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import StoryReader from "@/components/islands/StoryReader";
import { buildLadderCatalog, getLevelLadder, hrefForHalf, getStepProgress } from "@/lib/ladder";
import { loadGrammarMarkdown } from "@/lib/grammar";
import { loadCurriculumUnits } from "@/lib/curriculum";
import {
  getStoryPath,
  validateStoryReferences,
} from "@/lib/utils";
import type { Level } from "@/lib/progress";

export async function getStaticPaths() {
  const books = await getCollection("books");
  const stories = await getCollection("stories");
  const collections = await getCollection("flashcard-collections");
  const decks = await getCollection("flashcard-decks");
  const units = loadCurriculumUnits();

  // Referential integrity validation — fail the build if any story references a missing book
  const result = validateStoryReferences(
    stories.map((s) => ({ storyId: s.data.storyId, bookId: s.data.bookId })),
    books.map((b) => ({ bookId: b.data.bookId })),
  );

  if (!result.valid) {
    const messages = result.errors.map((e) => e.message).join("\n");
    throw new Error(
      `Referential integrity validation failed:\n${messages}`,
    );
  }

  const catalog = buildLadderCatalog({
    collections: collections.map((c) => ({
      collectionId: c.data.collectionId,
      difficulty: c.data.difficulty,
    })),
    decks: decks.map((d) => ({
      deckId: d.data.deckId,
      collectionId: d.data.collectionId,
      name: d.data.name,
      description: d.data.description,
      difficulty: d.data.difficulty,
    })),
    books: books.map((b) => ({
      bookId: b.data.bookId,
      difficulty: b.data.difficulty,
    })),
    stories: stories.map((s) => ({
      storyId: s.data.storyId,
      bookId: s.data.bookId,
      title: s.data.title,
      sentences: s.data.sentences,
    })),
    units,
  });

  const bookMap = new Map(books.map((b) => [b.data.bookId, b.data]));

  return stories.map((story) => {
    const meta = catalog.storyIndex[story.data.storyId];
    let nextHref: string | null = null;
    let nextLabel: string | null = null;
    let unitId: string | null = null;

    if (meta) {
      const ladder = getLevelLadder(catalog, meta.level);
      unitId = ladder.steps[meta.stepIndex]?.unitId ?? null;
      // next incomplete after this story (pretend this story is done for next calc)
      const completedStories = [story.data.storyId];
      const completedDecks: string[] = [];
      for (const step of ladder.steps) {
        const view = getStepProgress(step, completedDecks, completedStories);
        // Skip steps fully done under this hypothetical
        // Prefer next incomplete after current step index
        if (step.index <= meta.stepIndex) continue;
        if (view.nextHalf) {
          nextHref = hrefForHalf(step, view.nextHalf);
          nextLabel =
            view.nextHalf === "cards" && step.deck
              ? `Next: ${step.deck.name}`
              : step.story
                ? `Next: ${step.story.title}`
                : "Next step";
          break;
        }
      }
      // Also check same step's cards half if not done (won't be in completedDecks)
      if (!nextHref) {
        const current = ladder.steps[meta.stepIndex];
        if (current?.deck) {
          nextHref = hrefForHalf(current, "cards");
          nextLabel = `Cards: ${current.deck.name}`;
        }
      }
    }

    const unitPairMap: Record<
      string,
      {
        unitId: string;
        unitTitle?: string;
        level?: Level;
        stepIndex?: number;
        deck?: {
          deckId: string;
          collectionId: string;
          name: string;
        } | null;
      }
    > = {};
    for (const [uid, info] of Object.entries(catalog.unitIndex)) {
      if (info.story?.storyId === story.data.storyId) {
        unitPairMap[uid] = {
          unitId: uid,
          unitTitle: info.unitTitle,
          level: info.level ?? undefined,
          stepIndex: info.stepIndex,
          deck: info.deck
            ? {
                deckId: info.deck.deckId,
                collectionId: info.deck.collectionId,
                name: info.deck.name,
              }
            : null,
        };
        if (!unitId) unitId = uid;
      }
    }

    return {
      params: { bookId: story.data.bookId, storyId: story.data.storyId },
      props: {
        story: story.data,
        book: bookMap.get(story.data.bookId)!,
        level: meta?.level,
        stepIndex: meta?.stepIndex,
        nextHref,
        nextLabel,
        unitId,
        unitPairMap,
      },
    };
  });
}

const {
  story,
  book,
  level,
  stepIndex,
  nextHref,
  nextLabel,
  unitId,
  unitPairMap,
} = Astro.props;
const canonicalPath = getStoryPath(story.bookId, story.storyId);
const storyDescription = `Read "${story.title.target}" — a ${story.language} language learning story from ${book.name}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: story.title.target,
  description: storyDescription,
  url: `https://lingolotus.com${canonicalPath}`,
};

const sentences = story.sentences.map((s) => ({
  source: s.source,
  target: s.target,
  phonetic: s.phonetic,
  breakdown: s.breakdown,
}));

const grammarMarkdown = loadGrammarMarkdown(story.language);
---

<PageLayout
  title={`${story.title.target} - ${book.name} | Lingo Lotus`}
  description={storyDescription}
  ogType="article"
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <StoryReader
    client:load
    sentences={sentences}
    language={story.language}
    title={story.title}
    summary={story.summary}
    difficulty={story.difficulty}
    bookImageUrl={book.imageUrl}
    storyId={story.storyId}
    bookId={story.bookId}
    level={level}
    stepIndex={stepIndex}
    nextHref={nextHref}
    nextLabel={nextLabel}
    unitId={unitId}
    unitPairMap={unitPairMap}
    grammarMarkdown={grammarMarkdown}
  />
</PageLayout>
