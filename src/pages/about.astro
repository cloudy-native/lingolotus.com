---
import PageLayout from "../layouts/PageLayout.astro";

const aboutFile = await import("../../content/about.md");
const { Content, frontmatter } = aboutFile;
---

<PageLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogType="website"
  canonicalPath="/about"
  breadcrumbs={[{ label: "Learn", href: "/" }, { label: "About" }]}
>
  <article class="prose prose-stone max-w-none prose-headings:text-stone-900 prose-a:text-orange-800 prose-strong:text-stone-900">
    <Content />
  </article>
  <p class="mt-10 text-center">
    <a
      href="/"
      class="inline-flex items-center justify-center rounded-xl bg-orange-800 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-900"
    >
      Go to Learn
    </a>
  </p>
</PageLayout>
