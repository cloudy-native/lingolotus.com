---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import type { BreadcrumbItem } from "@/components/Breadcrumb.astro";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  canonicalPath: string;
  jsonLd?: Record<string, unknown>;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, ogType, canonicalPath, jsonLd, breadcrumbs } =
  Astro.props;

const navLinks = [
  { label: "Home", href: "/", icon: "home" },
  { label: "Flashcards", href: "/flash-cards", icon: "cards" },
  { label: "Reading", href: "/reading", icon: "book" },
  { label: "About", href: "/about", icon: "info" },
];

const currentPath = Astro.url.pathname;
---

<BaseLayout
  title={title}
  description={description}
  ogType={ogType}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <!-- Navigation Header -->
  <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-lg font-semibold text-slate-900">
        <span aria-hidden="true">🪷</span>
        <span>Lingo Lotus</span>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex md:items-center md:gap-6">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "inline-flex items-center gap-1.5 text-sm font-medium transition-colors hover:text-slate-900",
                currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
                  ? "text-teal-700"
                  : "text-slate-600",
              ]}
              aria-current={currentPath === link.href ? "page" : undefined}
            >
              {link.icon === "home" && (
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                </svg>
              )}
              {link.icon === "cards" && (
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25" />
                </svg>
              )}
              {link.icon === "book" && (
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
              )}
              {link.icon === "info" && (
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                </svg>
              )}
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-2 md:hidden">
        <button
          type="button"
          class="inline-flex items-center justify-center rounded-md p-2 text-slate-600 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-teal-500"
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="mobile-menu-button"
        >
          <span class="sr-only">Open main menu</span>
          <!-- Hamburger icon -->
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Navigation Menu -->
    <div id="mobile-menu" class="hidden border-t border-slate-200 md:hidden">
      <ul class="space-y-1 px-4 py-3">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block rounded-md px-3 py-2 text-base font-medium transition-colors",
                currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
                  ? "bg-teal-50 text-teal-700"
                  : "text-slate-600 hover:bg-slate-50 hover:text-slate-900",
              ]}
              aria-current={currentPath === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </header>

  <!-- Breadcrumbs -->
  {breadcrumbs && breadcrumbs.length > 0 && (
    <Breadcrumb items={breadcrumbs} />
  )}

  <!-- Main Content -->
  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-200">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
        <div>
          <p class="flex items-center gap-2 text-base font-semibold text-slate-900">
            <span aria-hidden="true">🪷</span> Lingo Lotus
          </p>
          <p class="mt-1 text-sm text-gray-500 ">
            &copy; {new Date().getFullYear()} Lingo Lotus. All rights reserved.
          </p>
          <p class="mt-1 text-sm text-gray-500 ">
            Made with ❤️ by <a href="https://dinsor.org" class="hover:text-teal-700 transition-colors">Stephen Harrison</a>
          </p>
        </div>
        <div class="flex flex-col items-end gap-2">
          <a
            href="https://github.com/cloudy-native/lingolotus.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50"
          >
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            Fork me on GitHub
          </a>
          <p class="text-xs text-slate-500">
            Built with <a href="https://astro.build" class="hover:text-teal-700">Astro</a>, <a href="https://www.typescriptlang.org" class="hover:text-teal-700">TypeScript</a> &amp; <a href="https://tailwindcss.com" class="hover:text-teal-700">Tailwind CSS</a>. Hosted on <a href="https://aws.amazon.com" class="hover:text-teal-700">AWS</a>.
          </p>
        </div>
      </div>
    </div>
  </footer>

  <!-- Mobile menu toggle script -->
  <script is:inline>
    (function () {
      var button = document.getElementById("mobile-menu-button");
      var menu = document.getElementById("mobile-menu");
      if (button && menu) {
        button.addEventListener("click", function () {
          var expanded = button.getAttribute("aria-expanded") === "true";
          button.setAttribute("aria-expanded", String(!expanded));
          menu.classList.toggle("hidden");
        });
      }
    })();
  </script>
</BaseLayout>
