---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import type { BreadcrumbItem } from "@/components/Breadcrumb.astro";
import GrammarLauncher from "@/components/islands/GrammarLauncher";
import ReaderSettings from "@/components/islands/ReaderSettings";

interface Props {
    title: string;
    description?: string;
    ogType?: "website" | "article";
    canonicalPath: string;
    jsonLd?: Record<string, unknown>;
    breadcrumbs?: BreadcrumbItem[];
    /** Show site-wide Grammar cheatsheet control (default true) */
    showGrammar?: boolean;
    grammarLevel?: string | null;
}

const {
    title,
    description,
    ogType,
    canonicalPath,
    jsonLd,
    breadcrumbs,
    showGrammar = true,
    grammarLevel = null,
} = Astro.props;

const navLinks = [
    { label: "Learn", href: "/", icon: "learn" },
    { label: "Browse", href: "/browse", icon: "browse" },
];

const currentPath = Astro.url.pathname;

function isNavActive(href: string, path: string): boolean {
    if (href === "/") {
        return path === "/" || path === "";
    }
    if (href === "/browse") {
        return (
            path === "/browse" ||
            path.startsWith("/browse/") ||
            path.startsWith("/flash-cards") ||
            path.startsWith("/reading")
        );
    }
    return path === href || path.startsWith(href + "/");
}
---

<BaseLayout
  title={title}
  description={description}
  ogType={ogType}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <!-- Navigation Header -->
  <header class="sticky top-0 z-50 border-b border-amber-200/80 bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/80 dark:border-stone-800 dark:bg-stone-950/95 dark:supports-[backdrop-filter]:bg-stone-950/80">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-lg font-semibold text-stone-900 dark:text-stone-50">
        <span aria-hidden="true">🪷</span>
        <span>Lingo Lotus</span>
      </a>

      <div class="flex items-center gap-2 sm:gap-4">
        <!-- Desktop Navigation -->
        <ul class="hidden md:flex md:items-center md:gap-6">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "inline-flex items-center gap-1.5 text-sm font-medium transition-colors hover:text-stone-900 dark:hover:text-white",
                  isNavActive(link.href, currentPath)
                    ? "text-orange-800 dark:text-orange-400"
                    : "text-stone-600 dark:text-stone-300",
                ]}
                aria-current={isNavActive(link.href, currentPath) ? "page" : undefined}
              >
                {link.icon === "learn" && (
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
                  </svg>
                )}
                {link.icon === "browse" && (
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                  </svg>
                )}
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Reading tools (Thai style, size, phonetics…) — persists site-wide -->
        <ReaderSettings client:load variant="nav" />

        <!-- Grammar: one island, all breakpoints -->
        {showGrammar && (
          <GrammarLauncher client:load languageCode="th" level={grammarLevel} />
        )}

        <!-- Mobile menu button -->
        <button
          type="button"
          class="inline-flex items-center justify-center rounded-md p-2 text-stone-600 hover:bg-stone-100 hover:text-stone-900 focus:outline-none focus:ring-2 focus:ring-orange-500 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-white md:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="mobile-menu-button"
        >
          <span class="sr-only">Open main menu</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Navigation Menu -->
    <div id="mobile-menu" class="hidden border-t border-amber-200/80 dark:border-stone-800 md:hidden">
      <ul class="space-y-1 px-4 py-3">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block rounded-md px-3 py-2 text-base font-medium transition-colors",
                isNavActive(link.href, currentPath)
                  ? "bg-orange-50 text-orange-800 dark:bg-orange-950 dark:text-orange-300"
                  : "text-stone-600 hover:bg-stone-50 hover:text-stone-900 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-white",
              ]}
              aria-current={isNavActive(link.href, currentPath) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </header>

  <!-- Breadcrumbs -->
  {breadcrumbs && breadcrumbs.length > 0 && (
    <Breadcrumb items={breadcrumbs} />
  )}

  <!-- Main Content -->
  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-amber-200/80 bg-amber-50/50 dark:border-stone-800 dark:bg-stone-950">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
        <div>
          <p class="flex items-center gap-2 text-base font-semibold text-stone-900 dark:text-stone-50">
            <span aria-hidden="true">🪷</span> Lingo Lotus
          </p>
          <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">
            &copy; {new Date().getFullYear()} Lingo Lotus. All rights reserved.
          </p>
          <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">
            Made with ❤️ by <a href="https://dinsor.org" class="hover:text-orange-800 dark:hover:text-orange-400 transition-colors">Stephen Harrison</a>
          </p>
        </div>
        <div class="flex flex-col items-center gap-2 sm:items-end">
          <nav class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm text-stone-600 dark:text-stone-400 sm:justify-end" aria-label="Footer">
            <a href="/" class="hover:text-orange-800 dark:hover:text-orange-400">Learn</a>
            <a href="/browse" class="hover:text-orange-800 dark:hover:text-orange-400">Browse</a>
            <a href="/about" class="hover:text-orange-800 dark:hover:text-orange-400">About</a>
          </nav>
          <p class="text-xs text-stone-500 dark:text-stone-500">Free forever · No account required</p>
          <a
            href="https://github.com/cloudy-native/lingolotus.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md border border-stone-200 bg-paper px-3 py-1.5 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-50 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-200 dark:hover:bg-stone-800"
          >
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            Fork me on GitHub
          </a>
          <p class="text-xs text-stone-500 dark:text-stone-500">
            Built with <a href="https://astro.build" class="hover:text-orange-800 dark:hover:text-orange-400">Astro</a>, <a href="https://www.typescriptlang.org" class="hover:text-orange-800 dark:hover:text-orange-400">TypeScript</a> &amp; <a href="https://tailwindcss.com" class="hover:text-orange-800 dark:hover:text-orange-400">Tailwind CSS</a>. Hosted on <a href="https://aws.amazon.com" class="hover:text-orange-800 dark:hover:text-orange-400">AWS</a>.
          </p>
        </div>
      </div>
    </div>
  </footer>

  <!-- Mobile menu toggle script -->
  <script is:inline>
    (function () {
      var button = document.getElementById("mobile-menu-button");
      var menu = document.getElementById("mobile-menu");
      if (button && menu) {
        button.addEventListener("click", function () {
          var expanded = button.getAttribute("aria-expanded") === "true";
          button.setAttribute("aria-expanded", String(!expanded));
          menu.classList.toggle("hidden");
        });
      }
    })();
  </script>
</BaseLayout>
