---
/**
 * ContentImage - Renders images referenced by content collection entries via imageUrl.
 * These images are served from the public/ directory without transformation.
 * Includes width, height, alt, and loading="lazy" attributes to prevent layout shift
 * and support accessibility (Requirement 11.5).
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: "eager" | "lazy";
}

const {
  src,
  alt,
  width = 400,
  height = 300,
  class: className,
  loading = "lazy",
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
/>
