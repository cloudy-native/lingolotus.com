{
    "name": "lingolotus",
    "version": "1.0.0",
    "private": true,
    "description": "Lingo Lotus - Learn languages naturally with flashcards and graded reading",
    "author": "",
    "keywords": [
        "astro",
        "language-learning",
        "flashcards"
    ],
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "clean": "rm -rf dist .astro",
        "deploy": "bash scripts/deploy.sh",
        "cdk": "pnpm --filter cdk run cdk",
        "cdk:build": "pnpm --filter cdk run build",
        "typecheck": "astro check && tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "biome format src",
        "format:fix": "biome format --write src",
        "lint": "biome check src",
        "optimize-images": "bash scripts/optimize-images.sh",
        "lint:fix": "biome check --write src"
    },
    "dependencies": {
        "@astrojs/react": "^5.0.7",
        "@astrojs/sitemap": "^3.7.3",
        "@astrojs/tailwind": "^6.0.2",
        "@radix-ui/react-navigation-menu": "^1.2.16",
        "@radix-ui/react-slot": "^1.3.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.1",
        "astro": "^7.1.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.503.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-icons": "^5.5.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "sharp": "^0.35.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.0.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@biomejs/biome": "2.2.4",
        "@eslint/js": "^9.25.1",
        "@types/node": "^20.19.17",
        "@types/react": "^18.3.24",
        "@types/react-dom": "^18.3.7",
        "@vitest/coverage-v8": "^4.1.9",
        "eslint": "^9.25.1",
        "eslint-plugin-react": "^7.37.5",
        "fast-check": "^4.8.0",
        "gh-pages": "^6.3.0",
        "globals": "^16.0.0",
        "typescript": "^5.0.2",
        "vitest": "^4.1.9",
        "zod": "^4.4.3"
    }
}
